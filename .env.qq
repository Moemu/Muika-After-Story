ENVIRONMENT=production
DRIVER=~fastapi+~httpx+~websockets

# ── Master user ──────────────────────────────────────
# 只有该 QQ 号码的用户可以与 Muika 对话
SUPERUSERS=["123456789"]
MASTER_ID=123456789

# ── IPC (Core 进程连接) ──────────────────────────────
# 必须与 Core 进程的 .env 中的 IPC_SECRET 一致！
# 新项目：先启动 Core（python -m muika.ipc.bootstrap），Core 会自动生成
#           IPC_SECRET 并写入 .env 文件，将其复制到此处
IPC_SECRET=your-ipc-secret-here

# Bot 在 Docker 内时使用 host.docker.internal 访问宿主机 Core
CORE_WS_URL=ws://host.docker.internal:8765/ws

# Bot 在宿主机上时（仅 NapCat 在 Docker 内）：
# CORE_WS_URL=ws://127.0.0.1:8765/ws

# ── OneBot (NapCat 连接) ─────────────────────────────
# Bot 在 Docker 内时使用容器名 napcat
ONEBOT_WS_URLS=["ws://napcat:3001"]

# Bot 在宿主机上时：
# ONEBOT_WS_URLS=["ws://localhost:3001"]

# ── 日志 ─────────────────────────────────────────────
LOG_LEVEL=INFO
MAS_LOG_ONLY=True
